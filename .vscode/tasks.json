{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CPM22: Configure Debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CPM22: Build Debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--parallel"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOrder": "sequence",
      "dependsOn": ["CPM22: Configure Debug"],
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "CPM22: Test Debug",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOrder": "sequence",
      "dependsOn": ["CPM22: Build Debug"],
      "problemMatcher": []
    },
    {
      "label": "CPM22: Run Debug",
      "type": "shell",
      "command": "${workspaceFolder}/build/Desktop_Debug/cpm-2.2",
      "args": [
        "--diskpath",
        "${workspaceFolder}/build/Desktop_Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build/Desktop_Debug"
      },
      "dependsOrder": "sequence",
      "dependsOn": ["CPM22: Build Debug"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    }
  ]
}
